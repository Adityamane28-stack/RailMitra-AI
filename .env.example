# =====================================================
# RailMitra AI - Environment Configuration Template
# Copy this file to .env and customize values for your deployment
# =====================================================

# Database Connection URL
# For PostgreSQL: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
# For SQLite (zero configuration): sqlite:///./railmitra.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/railmitra

# Server Configuration
PORT=8000
HOST=0.0.0.0

# JWT Authentication Secret Key (generate a secure random string for production)
JWT_SECRET_KEY=railmitra-secure-production-jwt-key-change-me-2026

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
